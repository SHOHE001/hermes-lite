# hermes-lite 共通設定の雛形。
# `cp .env.example .env` してから値を埋める（.env 自体は .gitignore 済み、コミットしない）。
# bin/run-claude.sh（各 jobs/）と systemd/*.service（EnvironmentFile）の両方から読まれる。

# --- claude -p 呼び出しの既定値（jobs/<name>/job.env で上書き可能） ---
DEFAULT_MAX_TURNS=
DEFAULT_TIMEOUT_SEC=
DEFAULT_MAX_BUDGET_USD=
DEFAULT_MODEL=

# --- Discord 通知（lib/notify.sh が使う webhook） ---
DISCORD_WEBHOOK_URL=

# --- SwitchBot API v1.1（Issue #12: 家電スケジュール） ---
# 取得手順: SwitchBot アプリ > プロフィール > 設定 > App Version を連打 >
# Developer Options が出現 > Get Token / Get Secret
# lib/switchbot.py と systemd/switchbot-action@.service が参照する。
# ログ・Discord 通知には値を出さない（CLAUDE.md 規約準拠）。
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
