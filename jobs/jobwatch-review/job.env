# jobwatch-review: jobwatch の判定結果を Claude が読み、異常を深掘りして
# Discord に報告するジョブ。
#
# jobwatch 自身が毎朝 07:30 に機械的なサマリを送る (jobwatch-daily.timer)。
# こちらはその 30 分後に走り、機械では判断できないこと — 失敗の原因、
# 対処の要否、設定の追加漏れ — を調べて言葉で報告する役割を持つ。
# 両方あることで、Claude 側が止まっても機械的サマリは届き続ける。
ALLOWED_TOOLS="Bash Read Glob Grep"
MAX_TURNS="40"
TIMEOUT_SEC="600"
MAX_BUDGET_USD="3.00"  # 1.00 では 2026-08-03/04 に error_max_budget_usd で落ちた。
                       # 2026-08-02 の点検範囲拡大 (db9457f) 以降の実測は 1.00 前後
                       # (8/5 は 0.998 で上限にほぼ張り付いた)。実測の 3 倍を確保する。
MODEL="sonnet"
NOTIFY_RESULT="1"
NOTIFY_ON_ERROR="1"
# 異常の有無にかかわらず毎朝投稿する。「今日も届いた」こと自体が、
# 監視が生きている証拠になる。正常時は 3 行以内に収めるよう prompt 側で指示。
