# mail-digest: mail-watch が var/mail-watch/pending.json に積んだ重要メールを
# 1 日 1 回まとめて Discord に通知するジョブ。詳細は docs/jobs-mail-watch.md を参照。
# メールは読まないので Gmail ツールは与えない（Read/Write のみ）。
ALLOWED_TOOLS="Read Write"
MAX_TURNS="10"
TIMEOUT_SEC="120"
MAX_BUDGET_USD="0.20"
MODEL="sonnet"
NOTIFY_RESULT="1"
NOTIFY_ON_ERROR="1"
# 保留 0 件の日に prompt が返す `[NOOP]` をラッパー側で検知して Discord 投稿をスキップする。
SUPPRESS_RESULT_IF="[NOOP]"

# 通知先は mail-watch と同じ専用チャンネル。
DISCORD_WEBHOOK_URL="${MAIL_WATCH_DISCORD_WEBHOOK_URL:-${DISCORD_WEBHOOK_URL:-}}"
