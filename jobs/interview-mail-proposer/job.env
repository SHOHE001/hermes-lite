# interview-mail-proposer: 面談確定メールから Calendar.create 承認依頼を起票するジョブ。
# 詳細は jobs/interview-mail-proposer/prompt.md / docs/discord-approval.md を参照。
#
# ALLOWED_TOOLS には Calendar.create を含めない (proposer は payload を作るだけで書き込まない)。
# Calendar.create は承認後に executor (lib/approvals_executor.py) が 1 回限り解禁して呼ぶ。
ALLOWED_TOOLS="mcp__claude_ai_Gmail__search_threads mcp__claude_ai_Gmail__get_thread Bash Read Write"
MAX_TURNS="50"
TIMEOUT_SEC="600"
MAX_BUDGET_USD="1.50"
MODEL="sonnet"
NOTIFY_RESULT="1"
NOTIFY_ON_ERROR="1"
# 0 件時に prompt が返す `[NOOP]` をラッパー側で検知して Discord 投稿をスキップする。
SUPPRESS_RESULT_IF="[NOOP]"
