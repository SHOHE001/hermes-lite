# mail-watch: 直近 12h に届いたメールを重要度判定し、重要なものだけ
# Discord に通知するジョブ。詳細は docs/jobs-mail-watch.md を参照。
# 通知済みの記録は var/mail-watch/notified.json（Gmail コネクタが読み取り専用で
# label_thread が使えないため）。Read/Write はこのファイル専用に許可している。
ALLOWED_TOOLS="mcp__claude_ai_Gmail__search_threads mcp__claude_ai_Gmail__get_thread Read Write"
MAX_TURNS="40"
TIMEOUT_SEC="300"
MAX_BUDGET_USD="1.00"
MODEL="sonnet"
NOTIFY_RESULT="1"
NOTIFY_ON_ERROR="1"
# 0 件時に prompt が返す `[NOOP]` をラッパー側で検知して Discord 投稿をスキップする（opt-in）。
SUPPRESS_RESULT_IF="[NOOP]"

# 通知先を mail-watch 専用チャンネルへ差し替える。
# run-claude.sh は .env(59行) -> job.env(85行) の順に source し、notify_discord は
# 投稿時(195/216行)に $DISCORD_WEBHOOK_URL を評価するので、ここでの再代入がそのまま効く。
# 未設定なら共通 webhook にフォールバックし、両方空なら notify.sh が WARN を出して
# 投稿をスキップする（ジョブ自体は落ちない）。
DISCORD_WEBHOOK_URL="${MAIL_WATCH_DISCORD_WEBHOOK_URL:-${DISCORD_WEBHOOK_URL:-}}"
