# mail-watch: 直近 12h に届いたメールを重要度判定し、重要なものだけ
# Discord に通知するジョブ。詳細は docs/jobs-mail-watch.md を参照。
# 通知したものにだけ `helmeslite-done` を付けて重複通知を防ぐため、unlabel は使わない。
ALLOWED_TOOLS="mcp__claude_ai_Gmail__list_labels mcp__claude_ai_Gmail__search_threads mcp__claude_ai_Gmail__get_thread mcp__claude_ai_Gmail__label_thread"
MAX_TURNS="40"
TIMEOUT_SEC="300"
MAX_BUDGET_USD="1.00"
MODEL="sonnet"
NOTIFY_RESULT="1"
NOTIFY_ON_ERROR="1"
# 0 件時に prompt が返す `[NOOP]` をラッパー側で検知して Discord 投稿をスキップする（opt-in）。
SUPPRESS_RESULT_IF="[NOOP]"
